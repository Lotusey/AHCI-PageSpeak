{
  "manifest_version": 3,
  "name": "Voice Web Navigation",
  "version": "0.2.0",
  "description": "Voice-first webpage navigation with numbered on-page labels.",
  "icons": {
    "16": "icons/pagespeak.png",
    "32": "icons/pagespeak.png",
    "48": "icons/pagespeak.png",
    "128": "icons/pagespeak.png"
  },
  "background": {
    "service_worker": "VUI/background.js"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://127.0.0.1:11434/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "VUI/pageAnalyzer.js",
        "VUI/actionEngine.js",
        "VUI/commandParser.js",
        "VUI/ollamaParser.js",
        "VUI/speech.js",
        "VUI/logger.js",
        "GUI/overlay.js",
        "GUI/labels.js",
        "VUI/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "GUI/styles.css",
        "icons/pagespeak.png"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
