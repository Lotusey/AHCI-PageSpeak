{
  "manifest_version": 3,
  "name": "Voice Web Navigation",
  "version": "0.1.0",
  "description": "Voice-first webpage navigation using the Web Speech API.",
  "permissions": [],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/pageAnalyzer.js",
        "src/actionEngine.js",
        "src/commandParser.js",
        "src/speech.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}